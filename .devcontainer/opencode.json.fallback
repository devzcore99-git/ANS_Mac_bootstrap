{
  "$schema": "https://opencode.ai/config.json",

  // Workspace rules that every project carries at .claude/rules/workspace.md.
  // Claude Code reads that directory natively; opencode does not, and it does
  // NOT expand @-imports inside CLAUDE.md either, so this glob is the only way
  // the shared rules reach opencode.
  //
  // The path is resolved against the PROJECT root (the nearest git directory
  // above the working directory), not against this config file - verified on
  // opencode 1.18.21, including from a subdirectory. That is what lets one
  // config serve every project without a per-project opencode.json.
  //
  // The glob is deliberately non-recursive: .claude/rules/scoped/*.md holds
  // path-scoped rules that Claude Code loads only when it reads a matching
  // file, and opencode has no equivalent, so it should not swallow them.
  //
  // A host-level override at ~/.config/devcontainer/opencode.jsonc REPLACES
  // this file rather than layering onto it, so any override must carry this
  // key too or its devpods lose the shared rules.
  "instructions": [".claude/rules/*.md"],
  "provider": {
    "ham51-2": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ham51-2",
      "options": {
        "baseURL": "{env:OPENAI_BASE_URL}",
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "qwen/qwen3.6-35b-a3b": {
          "name": "qwen/qwen3.6-35b-a3b",
          "limit": {
            "context": 128000,
            "output": 32768
          }
        },
        "qwen/qwen3.5-9b": {
          "name": "qwen/qwen3.5-9b",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        }
      }
    }
  },
  "model": "ham51-2/qwen/qwen3.6-35b-a3b",

  // Pruning drops stale tool output incrementally instead of letting a session
  // run up to a full summarizing rewrite; it is off by default.
  //
  // No "reserved" here, deliberately. It only applies to a model that declares
  // limit.input (trigger = input - reserved); the models above declare
  // context/output only, so their trigger is context - min(output, 32000) and
  // a reserved value would be inert. It is also GLOBAL with no per-agent
  // override: set it in a host override only after checking the smallest
  // limit.input there, or a small model's trigger collapses to zero and it
  // compacts on every step.
  //
  // No "model" either - one set here is dropped silently. The compaction model
  // goes under "agent": { "compaction": { "model": ... } }.
  "compaction": {
    "auto": true,
    "prune": true
  }
}
